; TIP4P (Jorgensen), parameters of oplsaa.ff so grompp needs no
; force-field directory. SETTLE, exclusions and the M virtual site
; are the standard tip4p.itp.
[ defaults ]
; nbfunc comb-rule gen-pairs fudgeLJ fudgeQQ
1 3 yes 0.5 0.5

[ atomtypes ]
; name at.num mass charge ptype sigma epsilon
OW 8 15.99940 0.000 A 3.15365e-01 6.48520e-01
HW 1  1.00800 0.520 A 0.00000e+00 0.00000e+00
MW 0  0.00000 -1.040 D 0.00000e+00 0.00000e+00

[ moleculetype ]
SOL 2

[ atoms ]
; nr type resnr residue atom cgnr charge
1 OW 1 SOL OW 1 0.0
2 HW 1 SOL HW1 1 0.52
3 HW 1 SOL HW2 1 0.52
4 MW 1 SOL MW 1 -1.04

[ settles ]
; OW funct doh dhh
1 1 0.09572 0.15139

[ exclusions ]
1 2 3 4
2 1 3 4
3 1 2 4
4 1 2 3

[ virtual_sites3 ]
; site from funct a b
; M = O + a*(H1-O) + b*(H2-O), a = b = 0.128012065
4 1 2 3 1 0.128012065 0.128012065

[ system ]
two TIP4P waters

[ molecules ]
SOL 2
