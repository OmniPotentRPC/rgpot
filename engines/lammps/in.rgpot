# Two atoms, metal units. pair_style rgpot is the plugin built from
# engines/lammps/pair_rgpot.cpp. Load it before this file:
#   plugin load pair_rgpot.so
units metal
atom_style atomic
boundary p p p
atom_modify map array
region box block 0 20 0 20 0 20
create_box 1 box
create_atoms 1 single 0 0 0
create_atoms 1 single 1.5 0 0
mass 1 1.0
pair_style rgpot 8.0
pair_coeff * * 1.0 1.0
run 0
