@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(@RGPOT_WITH_RPC@)
  find_dependency(CapnProto)
endif()
if(NOT @RGPOT_RPC_CLIENT_ONLY@)
  find_dependency(Threads)
  if(@RGPOT_WITH_CACHE@)
    find_dependency(RocksDB)
    list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(xxHash)
    list(POP_BACK CMAKE_MODULE_PATH)
  endif()
  if(NOT @RGPOT_PURE_LIB@)
    find_dependency(fmt)
  endif()
  if(@RGPOT_WITH_XTENSOR@)
    find_dependency(xtensor)
    find_dependency(xtensor-blas)
  endif()
  if(@RGPOT_WITH_EIGEN@)
    find_dependency(Eigen3 3.4.0)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/rgpotTargets.cmake")
check_required_components(rgpot)
