# The Potentials.capnp contract rgpot vendors: rgconf's potential.capnp and
# the common.capnp it imports, at this commit. CppCore/rgpot/rpc and
# rgpot-core/schema carry both files byte for byte as Potentials.capnp and
# common.capnp; schema_ledger.py check --fetch compares them with the pin.
[rgconf]
url = https://github.com/OmniPotentRPC/rgconf.git
revision = b642c02cb44b7c8658692c8d02c779c8b4bb7a90
schema = crates/rgconf-core/schema/potential.capnp
common = crates/rgconf-core/schema/common.capnp
