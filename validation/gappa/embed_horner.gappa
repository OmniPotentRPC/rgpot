# Two fused steps of the embedded-atom polynomial, coefficients in the
# range of the aluminium embedding function.
# result = fma(result, rho, coeff).

@rnd = float<ieee_64, ne>;

c0 = rnd(c8);
c1 = rnd(c0 * rho + c7);
c2 = rnd(c1 * rho + c6);
e0 = c0 - c8;
e1 = c1 - (c0 * rho + c7);
e2 = c2 - (c1 * rho + c6);

{
  rho in [0, 2] /\
  c8 in [-1, 1] /\ c7 in [-20, 20] /\ c6 in [-80, 80] ->
  e0 in [-1b-53, 1b-53] /\
  e1 in [-1b-46, 1b-46] /\
  e2 in [-1b-45, 1b-45]
}
