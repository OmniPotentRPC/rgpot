+# @struct ExprTerm
+# @brief One named child in an ExprParams composition tree.
+#
+# `name` is the Lepton identifier used in ExprParams.expression.
+# `pot` is a PotSpec so a child may itself be an expression.
+struct ExprTerm {
+  name @0 :Text;
+  pot @1 :PotSpec;
+}
+
+# @struct ExprParams
+# @brief Recursive PES algebra for RPC/config. Not a PotentialConfig arm.
+#
+# The C++ ExprPot constructor (expression string plus named
+# unique_ptr<PotentialBase> children) is the first-slice API.
+# This tree names the same composition on the wire (e.g. "0.5*lj + d3")
+# without a flat scale list. Leaf PotSpec arms land when those pots
+# grow config structs; do not invent dummy leaves.
+struct ExprParams {
+  expression @0 :Text;
+  terms @1 :List(ExprTerm);
+}
+
+# @struct PotSpec
+# @brief Recursive potential tree used only for composition.
+#
+# Not a PotentialConfig arm. PotentialConfig stays a single-backend
+# configure union (none / nwchem / cpmd / metatomic).
+struct PotSpec {
+  union {
+    expr @0 :ExprParams;
+    none @1 :Void; # Empty node. Leaf arms land when those pots grow config structs.
+  }
+}
+
 # @struct PotentialConfig
 # @brief **rgpot user parameters (extensible, in/out via Cap'n Proto only).**
 #
@@ -2580,4 +2629,63 @@
   # @return The protocol, schema, eindir bridge, DLPack and build identity.
   # buildVersion and buildRevision are empty when the build does not know them.
   getCapabilities @12 () -> (capabilities :Capabilities);
+
+  # One chunk of a neighbour query. The whole list is not required on the wire.
+  # The client sends NeighborRequest.cursor and repeats the call while
+  # NeighborList.more is true, passing NeighborList.next back as the next cursor.
+  neighbours @13 (fip :ForceInput, request :NeighborRequest) -> (neighbors :NeighborList);
+}
+
+# Neighbour query. The same columns as rgpot::nlist::Query and rgpot_nlist_soa.
+# format: 0 half pairs, 1 full pairs, 2 cluster of four. A cluster is the full
+# interaction set. There is no half cluster, because format is one field.
+# cut: 0 strict (distance < cutoff), 1 loose (distance < cutoff + skin,
+# or distance <= cutoff when skin is 0).
+# mode: 1 one stored chunk, 2 a stream that honours cursor and limit.
+# 0 is not a mode. cursor is the pair index this chunk starts at.
+# limit is the maximum pairs in the reply. 0 means 4096 on a stream.
+# periodic empty means every axis is periodic. Box rows are the lattice vectors.
+struct NeighborRequest {
+  cutoff @0 :Float64;
+  skin @1 :Float64 = 0;
+  format @2 :UInt8 = 0;
+  cut @3 :UInt8 = 0;
+  periodic @4 :List(Bool);
+  shifts @5 :Bool = true;
+  vectors @6 :Bool = true;
+  distances @7 :Bool = true;
+  mode @8 :UInt8 = 1;
+  cursor @9 :UInt64 = 0;
+  limit @10 :UInt32 = 0;
+  # Empty for one system. Each entry is a system that does not interact
+  # with the others. Positions are concatenated in the same order, and
+  # NeighborList.first indexes that concatenation. NeighborList.system
+  # is the system of each pair.
+  systems @11 :List(NeighborSystem);
+}
+
+struct NeighborSystem {
+  count @0 :UInt32;
+  box @1 :List(Float64);
+}
+
+# One chunk. first and second have the same length. shift has 3 times that
+# length when shifts were requested, vector has 3 times that length, distance
+# has that length. mask is one byte per pair, 0xff for a pair list and the
+# low four bits for a cluster. more is true when a later chunk exists.
+# next is the cursor to send for that chunk. status 0 is success. message
+# is a sentence when status is not 0. The lists are empty in that case.
+struct NeighborList {
+  first @0 :List(Int32);
+  second @1 :List(Int32);
+  shift @2 :List(Int32);
+  vector @3 :List(Float64);
+  distance @4 :List(Float64);
+  mask @5 :List(UInt8);
+  more @6 :Bool = false;
+  next @7 :UInt64 = 0;
+  status @8 :Int32 = 0;
+  message @9 :Text;
+  # System id of each pair. Empty when the request named one system.
+  system @10 :List(Int32);
 }
